{
  "_izoh": "Tradovate web (trader.tradovate.com) — 2026-11-26 da Tradeify hisobida o'qilgan data-testid'lar. Sayt tilidan qat'i nazar ishlaydi. verify/flatten qadamlari birinchi haqiqiy bitimda tekshirilib, keyin calibrated=true qilinadi.",
  "calibrated": false,
  "login": {
    "user": [
      "#name-input"
    ],
    "password": [
      "#password-input"
    ],
    "code_input": [
      "input[autocomplete='one-time-code']",
      "input[name*='code' i]",
      "input[placeholder*='code' i]"
    ],
    "code_submit": [
      "button:has-text('Verify')",
      "button:has-text('Submit')",
      "button:has-text('Continue')",
      "button:has-text('Подтвердить')"
    ],
    "welcome_close": [
      "button.close-button"
    ],
    "env_select": [
      "button:has-text('Access Simulation')",
      "button:has-text('Доступ к симуляции')"
    ],
    "captcha": [
      "iframe[src*='captcha']",
      "iframe[title*='challenge' i]"
    ],
    "ready": [
      "[data-testid='order-ticket-send-button']"
    ]
  },
  "prepare_steps": [
    {
      "do": "type",
      "what": "kontrakt (symbol) maydoni",
      "sel": [
        "[data-testid='order-ticket-symbol-search']"
      ],
      "value": "{symbol}"
    },
    {
      "do": "wait",
      "what": "kontrakt ro'yxati",
      "sel": [
        "[data-testid='typeahead-wrapper'].open li a:has-text('{symbol}')"
      ],
      "timeout_ms": 6000
    },
    {
      "do": "press",
      "what": "kontraktni tanlash",
      "sel": [
        "[data-testid='order-ticket-symbol-search']"
      ],
      "key": "Enter",
      "pause": 1.0
    },
    {
      "do": "click",
      "what": "buyurtma turi ro'yxati",
      "sel": [
        "[data-testid='order-ticket-order-type-select'] > div"
      ]
    },
    {
      "do": "click",
      "what": "LIMIT turi (narxni o'qish uchun)",
      "sel": [
        "[data-testid='order-ticket-order-type-select'] li >> nth=1"
      ],
      "pause": 1.0
    }
  ],
  "price": [
    "[data-testid='order-ticket-price-input'] input"
  ],
  "order_steps": [
    {
      "do": "click",
      "side": "BUY",
      "what": "Buy (Купить)",
      "sel": [
        "[data-testid='order-ticket-action-switch'] label >> nth=0"
      ]
    },
    {
      "do": "click",
      "side": "SELL",
      "what": "Sell (Продать)",
      "sel": [
        "[data-testid='order-ticket-action-switch'] label >> nth=1"
      ]
    },
    {
      "do": "fill",
      "what": "kontrakt soni",
      "sel": [
        "[data-testid='order-ticket-quantity'] input"
      ],
      "value": "{qty}"
    },
    {
      "do": "click",
      "what": "buyurtma turi ro'yxati",
      "sel": [
        "[data-testid='order-ticket-order-type-select'] > div"
      ]
    },
    {
      "do": "click",
      "what": "MARKET turi",
      "sel": [
        "[data-testid='order-ticket-order-type-select'] li >> nth=0"
      ]
    },
    {
      "do": "click",
      "optional": true,
      "what": "bracket (SL/TP) yoqish",
      "sel": [
        "[data-testid='simple-tpsl-order-ticket-enable-tpsl-button']"
      ],
      "pause": 0.8
    },
    {
      "do": "click",
      "what": "o'lchov birligi ro'yxati",
      "sel": [
        "[data-testid='simple-tpsl-show-in-units-select'] > div"
      ]
    },
    {
      "do": "click",
      "what": "Tiklar",
      "sel": [
        "[data-testid='simple-tpsl-show-in-units-select'] li >> nth=0"
      ]
    },
    {
      "do": "ensure_class",
      "what": "TP belgisi",
      "sel": [
        "[data-testid='simple-tpsl-bracket-0-take-profit-checkbox-label']"
      ],
      "cls": "checkbox-active"
    },
    {
      "do": "ensure_class",
      "what": "SL belgisi",
      "sel": [
        "[data-testid='simple-tpsl-bracket-0-stop-loss-checkbox-label']"
      ],
      "cls": "checkbox-active"
    },
    {
      "do": "fill",
      "what": "TP (tik)",
      "sel": [
        "[data-testid='simple-tpsl-bracket-0-take-profit-input'] input"
      ],
      "value": "{tp_ticks}"
    },
    {
      "do": "fill",
      "what": "SL (tik)",
      "sel": [
        "[data-testid='simple-tpsl-bracket-0-stop-loss-input'] input"
      ],
      "value": "{sl_ticks}"
    },
    {
      "do": "click",
      "what": "Yuborish (Отправить)",
      "sel": [
        "[data-testid='order-ticket-send-button']"
      ]
    },
    {
      "do": "expect_text",
      "side": "BUY",
      "what": "tasdiqlash oynasi",
      "sel": [
        "#placeholder-for-modals .popover-content"
      ],
      "contains": [
        " {qty} ",
        "MKT+{tp_pts}",
        "MKT-{sl_pts}"
      ]
    },
    {
      "do": "expect_text",
      "side": "SELL",
      "what": "tasdiqlash oynasi",
      "sel": [
        "#placeholder-for-modals .popover-content"
      ],
      "contains": [
        " {qty} ",
        "MKT-{tp_pts}",
        "MKT+{sl_pts}"
      ]
    },
    {
      "do": "click",
      "submit": true,
      "what": "tasdiqlash tugmasi",
      "sel": [
        "#placeholder-for-modals .popover-content .btn-group-justified .btn-group >> nth=0"
      ],
      "pause": 2.0
    }
  ],
  "verify_steps": [
    {
      "do": "click",
      "what": "Ордера bo'limi",
      "sel": [
        ".lm_tab:has-text('Ордера')",
        ".lm_tab:has-text('Orders')"
      ],
      "pause": 1.5
    },
    {
      "do": "fail_if_text",
      "what": "rad etilganmi",
      "sel": [
        ".lm_content:visible"
      ],
      "words": [
        "Отклонен",
        "Rejected"
      ]
    },
    {
      "do": "wait",
      "what": "SL buyurtmasi (STOP) ishlayapti — TODO: birinchi haqiqiy bitimda aniqlanadi",
      "sel": [
        ".lm_content:visible:has-text('СТОП')",
        ".lm_content:visible:has-text('STOP')"
      ],
      "timeout_ms": 8000
    }
  ],
  "flatten_steps": [
    {
      "do": "click",
      "what": "Exit at Mkt & Cxl — TODO: birinchi haqiqiy bitimda aniqlanadi",
      "sel": [
        "button:has-text('Exit at Mkt')",
        "button:has-text('Выйти по рынку')"
      ]
    }
  ]
}