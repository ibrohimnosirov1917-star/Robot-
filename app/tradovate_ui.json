{
  "_izoh": "Tradovate web (trader.tradovate.com) — 2026-11-26 da Tradeify hisobida haqiqiy sinov bitimi bilan tekshirilgan data-testid'lar. Sayt tilidan qat'i nazar ishlaydi (rus/ingliz).",
  "calibrated": true,
  "login": {
    "user": [
      "#name-input"
    ],
    "password": [
      "#password-input"
    ],
    "code_input": [
      "input[autocomplete='one-time-code']",
      "input[name*='code' i]",
      "input[placeholder*='code' i]"
    ],
    "code_submit": [
      "button:has-text('Verify')",
      "button:has-text('Submit')",
      "button:has-text('Continue')",
      "button:has-text('Подтвердить')"
    ],
    "welcome_close": [
      "button.close-button",
      "button:has-text('Продолжить')",
      "button:has-text('Continue')"
    ],
    "env_select": [
      "button:has-text('Access Simulation')",
      "button:has-text('Доступ к симуляции')",
      "button:has-text('Simulation')"
    ],
    "captcha": [
      "iframe[src*='captcha']",
      "iframe[title*='challenge' i]"
    ],
    "ready": [
      "[data-testid='order-ticket-send-button']"
    ]
  },
  "prepare_steps": [
    {
      "do": "click",
      "optional": true,
      "what": "yordam oynachasini yopish",
      "sel": [
        ".popover button:text-is('Закрыть')",
        ".popover .btn:text-is('Закрыть')",
        ".popover button:text-is('Close')",
        ".popover .btn:text-is('Close')",
        ".popover button:text-is('Got it')"
      ],
      "timeout_ms": 800,
      "pause": 0.5
    },
    {
      "do": "click",
      "optional": true,
      "what": "yordam oynachasini yopish",
      "sel": [
        ".popover button:text-is('Закрыть')",
        ".popover .btn:text-is('Закрыть')",
        ".popover button:text-is('Close')",
        ".popover .btn:text-is('Close')",
        ".popover button:text-is('Got it')"
      ],
      "timeout_ms": 800,
      "pause": 0.5
    },
    {
      "do": "click",
      "optional": true,
      "what": "yordam oynachasini yopish",
      "sel": [
        ".popover button:text-is('Закрыть')",
        ".popover .btn:text-is('Закрыть')",
        ".popover button:text-is('Close')",
        ".popover .btn:text-is('Close')",
        ".popover button:text-is('Got it')"
      ],
      "timeout_ms": 800,
      "pause": 0.5
    },
    {
      "do": "type",
      "what": "kontrakt (symbol) maydoni",
      "sel": [
        "[data-testid='order-ticket-symbol-search']"
      ],
      "value": "{symbol}"
    },
    {
      "do": "wait",
      "what": "kontrakt ro'yxati",
      "sel": [
        "[data-testid='typeahead-wrapper'].open li a:has-text('{symbol}')"
      ],
      "timeout_ms": 6000
    },
    {
      "do": "press",
      "what": "kontraktni tanlash",
      "sel": [
        "[data-testid='order-ticket-symbol-search']"
      ],
      "key": "Enter",
      "pause": 1.0
    },
    {
      "do": "click",
      "what": "buyurtma turi ro'yxati",
      "sel": [
        "[data-testid='order-ticket-order-type-select'] > div"
      ]
    },
    {
      "do": "click",
      "what": "LIMIT turi (narxni o'qish uchun)",
      "sel": [
        "[data-testid='order-ticket-order-type-select'] li >> nth=1"
      ],
      "pause": 1.0
    }
  ],
  "price": [
    "[data-testid='order-ticket-price-input'] input"
  ],
  "order_steps": [
    {
      "do": "click",
      "side": "BUY",
      "what": "Buy (Купить)",
      "sel": [
        "[data-testid='order-ticket-action-switch'] label >> nth=0"
      ]
    },
    {
      "do": "click",
      "side": "SELL",
      "what": "Sell (Продать)",
      "sel": [
        "[data-testid='order-ticket-action-switch'] label >> nth=1"
      ]
    },
    {
      "do": "fill",
      "what": "kontrakt soni",
      "sel": [
        "[data-testid='order-ticket-quantity'] input"
      ],
      "value": "{qty}"
    },
    {
      "do": "click",
      "what": "buyurtma turi ro'yxati",
      "sel": [
        "[data-testid='order-ticket-order-type-select'] > div"
      ]
    },
    {
      "do": "click",
      "what": "MARKET turi",
      "sel": [
        "[data-testid='order-ticket-order-type-select'] li >> nth=0"
      ]
    },
    {
      "do": "click",
      "optional": true,
      "what": "bracket (SL/TP) yoqish",
      "sel": [
        "[data-testid='simple-tpsl-order-ticket-enable-tpsl-button']"
      ],
      "pause": 0.8
    },
    {
      "do": "click",
      "what": "o'lchov birligi ro'yxati",
      "sel": [
        "[data-testid='simple-tpsl-show-in-units-select'] > div"
      ]
    },
    {
      "do": "click",
      "what": "Tiklar",
      "sel": [
        "[data-testid='simple-tpsl-show-in-units-select'] li >> nth=0"
      ]
    },
    {
      "do": "ensure_class",
      "what": "TP belgisi",
      "sel": [
        "[data-testid='simple-tpsl-bracket-0-take-profit-checkbox-label']"
      ],
      "cls": "checkbox-active"
    },
    {
      "do": "ensure_class",
      "what": "SL belgisi",
      "sel": [
        "[data-testid='simple-tpsl-bracket-0-stop-loss-checkbox-label']"
      ],
      "cls": "checkbox-active"
    },
    {
      "do": "fill",
      "what": "TP (tik)",
      "sel": [
        "[data-testid='simple-tpsl-bracket-0-take-profit-input'] input"
      ],
      "value": "{tp_ticks}"
    },
    {
      "do": "fill",
      "what": "SL (tik)",
      "sel": [
        "[data-testid='simple-tpsl-bracket-0-stop-loss-input'] input"
      ],
      "value": "{sl_ticks}"
    },
    {
      "do": "click",
      "what": "Yuborish (Отправить)",
      "sel": [
        "[data-testid='order-ticket-send-button']"
      ]
    },
    {
      "do": "expect_text",
      "side": "BUY",
      "what": "tasdiqlash oynasi",
      "sel": [
        "#placeholder-for-modals .popover-content"
      ],
      "contains": [
        " {qty} ",
        "MKT+{tp_pts}",
        "MKT-{sl_pts}"
      ]
    },
    {
      "do": "expect_text",
      "side": "SELL",
      "what": "tasdiqlash oynasi",
      "sel": [
        "#placeholder-for-modals .popover-content"
      ],
      "contains": [
        " {qty} ",
        "MKT-{tp_pts}",
        "MKT+{sl_pts}"
      ]
    },
    {
      "do": "click",
      "submit": true,
      "what": "tasdiqlash tugmasi",
      "sel": [
        "#placeholder-for-modals .popover-content .btn-group-justified .btn-group >> nth=0"
      ],
      "pause": 2.0
    }
  ],
  "verify_steps": [
    {
      "do": "sleep",
      "sec": 1.5
    },
    {
      "do": "fail_if_text",
      "what": "rad etilganmi",
      "sel": [
        "[data-testid='order-history']",
        ".lm_content:visible"
      ],
      "words": [
        "Отклонен",
        "Rejected"
      ]
    },
    {
      "do": "expect_lines",
      "what": "kirish bajarildi, SL va TP ishlayapti",
      "sel": [
        "[data-testid='trading-ticket-header']",
        ".lm_content:visible"
      ],
      "patterns": [
        "(МКТ|MKT).*(Выполнен|Filled)",
        "(СТОП|STOP).*(Рабочий|Working)",
        "(ЛИМИТ|LIMIT).*(Рабочий|Working)"
      ],
      "timeout_ms": 10000
    }
  ],
  "flatten_steps": [
    {
      "do": "click",
      "what": "hisob menyusi",
      "sel": [
        "[data-testid='account-info-dropdown-toggle']"
      ],
      "pause": 0.8
    },
    {
      "do": "click",
      "what": "Закрыть Все Позиции и Отменить",
      "sel": [
        ".panic-button"
      ],
      "pause": 1.0
    },
    {
      "do": "click",
      "optional": true,
      "what": "yopishni tasdiqlash",
      "sel": [
        "#placeholder-for-modals .popover-content .btn-group-justified .btn-group >> nth=0",
        "#placeholder-for-modals .btn-danger",
        "#placeholder-for-modals .btn-primary"
      ],
      "timeout_ms": 3000,
      "pause": 1.5
    },
    {
      "do": "expect_lines",
      "what": "pozitsiyalar 0",
      "sel": [
        ".risk-settings"
      ],
      "patterns": [
        "(Позиции|Positions):\\s*\\+\\s*0\\s*/\\s*-\\s*0"
      ],
      "timeout_ms": 10000,
      "any_visibility": true
    }
  ]
}